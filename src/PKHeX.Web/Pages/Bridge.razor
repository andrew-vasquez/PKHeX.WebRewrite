@page "/bridge"
@implements IDisposable
@layout EmptyLayout
@using PKHeX.Facade
@using PKHeX.Facade.Extensions
@using PKHeX.Facade.Pokemons
@using PKHeX.Core
@using Gender = PKHeX.Facade.Gender
@using System.Text.Json
@using System.Text.Json.Serialization
@using Microsoft.JSInterop
@using PKHeX.Facade.Repositories
@using PKHeX.Web.Plugins
@using PKHeX.Web.Services.Plugins
@inject IJSRuntime Js
@inject GameService GameService
@inject PlugInRegistry PlugInRegistry
@inject PlugInRuntime PlugInRuntime
@inject PlugInService PlugInService
@inject PlugInSourceService PlugInSourceService
@inject PlugInSourceLocalStorage PlugInSourceLocalStorage
@inject PlugInLocalStorage PlugInLocalStorage
@inject PlugInPageRegistry PlugInPageRegistry

<div class="bridge-shell @(_page is null ? string.Empty : "bridge-shell--active")">
    @if (_page is not null)
    {
        @if (_page.Layout == Outcome.PlugInPage.PageLayout.Standard)
        {
            <div class="bridge-standard-shell">
                @if (_page.PageHeader is not null)
                {
                    <header class="bridge-page-header">
                        <div>
                            <div class="bridge-page-eyebrow">Plug-in</div>
                            <h1>@_page.PageHeader.Title</h1>
                        </div>

                        @if (_page.PageHeader.ComponentType is not null)
                        {
                            <DynamicComponent Type="_page.PageHeader.ComponentType" Parameters="@AssembleComponentParams()" />
                        }
                    </header>
                }

                <section class="bridge-page-body">
                    <DynamicComponent Type="_page.ComponentType" Parameters="@AssembleComponentParams()" />
                </section>
            </div>
        }
        else
        {
            <div class="bridge-empty-shell">
                <DynamicComponent Type="_page.ComponentType" Parameters="@AssembleComponentParams()" />
            </div>
        }
    }
</div>

@code {
    private DotNetObjectReference<Bridge>? _reference;
    private Outcome.PlugInPage? _page;
    private LoadedPlugIn? _plugIn;
    private Pokemon? _draftPokemon;
    private List<Encounter> _encounterResults = [];

    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web)
    {
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull,
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _reference = DotNetObjectReference.Create(this);
        await Js.InvokeVoidAsync("pkhexBridge.initialize", _reference);
    }

    [JSInvokable]
    public async Task<string> HandleRequest(string json)
    {
        try
        {
            var request = JsonSerializer.Deserialize<BridgeRequest>(json, JsonOptions)
                          ?? throw new InvalidOperationException("Invalid bridge request.");

            var data = await (request.Command switch
            {
                "getState" => GetState(),
                "loadSave" => LoadSave(request.Payload),
                "updateTrainer" => UpdateTrainer(request.Payload),
                "exportSave" => ExportSave(),
                "getCollection" => GetCollection(request.Payload),
                "getPokemon" => GetPokemon(request.Payload),
                "savePokemon" => SavePokemon(request.Payload),
                "exportPokemon" => ExportPokemon(request.Payload),
                "loadDraftPokemon" => LoadDraftPokemon(request.Payload),
                "createCloneDraft" => CreateCloneDraft(request.Payload),
                "getDraftPokemon" => GetDraftPokemon(),
                "addDraftPokemonToCollection" => AddDraftPokemonToCollection(request.Payload),
                "clearDraftPokemon" => ClearDraftPokemon(),
                "getEncounterSearch" => GetEncounterSearch(),
                "searchEncounters" => SearchEncounters(request.Payload),
                "createEncounterDraft" => CreateEncounterDraft(request.Payload),
                "getItems" => GetItems(),
                "setItemCount" => SetItemCount(request.Payload),
                "getPluginFailures" => GetPluginFailures(),
                "dismissPluginFailure" => DismissPluginFailure(request.Payload),
                "getPlugins" => GetPlugins(),
                "addPluginSource" => AddPluginSource(request.Payload),
                "removePluginSource" => RemovePluginSource(request.Payload),
                "getPlugin" => GetPlugin(request.Payload),
                "installPlugin" => InstallPlugin(request.Payload),
                "uninstallPlugin" => UninstallPlugin(request.Payload),
                "updatePlugin" => UpdatePlugin(request.Payload),
                "setPluginEnabled" => SetPluginEnabled(request.Payload),
                "setHookEnabled" => SetHookEnabled(request.Payload),
                "setPluginSetting" => SetPluginSetting(request.Payload),
                "runQuickAction" => RunQuickAction(request.Payload),
                "showPluginPage" => ShowPluginPage(request.Payload),
                "clearPluginPage" => ClearPluginPage(),
                _ => throw new NotSupportedException($"Unknown bridge command '{request.Command}'.")
            });

            return JsonSerializer.Serialize(new BridgeResponse(true, data, null), JsonOptions);
        }
        catch (Exception e)
        {
            return JsonSerializer.Serialize(new BridgeResponse(false, null, e.Message), JsonOptions);
        }
    }

    private Task<object> GetState()
    {
        var game = GameService.Game;
        return Task.FromResult<object>(new
        {
            loaded = GameService.IsLoaded,
            fileName = GameService.FileName,
            gameVersion = game?.SaveVersion.Name,
            trainer = game is null
                ? null
                : new
                {
                    id = game.Trainer.Id.ToString(),
                    name = game.Trainer.Name,
                    rivalName = game.Trainer.RivalName,
                    money = game.Trainer.Money.Amount,
                    battlePoints = game.BattlePoints.IsSupported(out var supported) ? supported.BattlePoints : (int?)null,
                    gender = game.Trainer.Gender.Name,
                    genderSymbol = game.Trainer.Gender.Symbol,
                },
            quickActions = PlugInRegistry.GetAllEnabledHooks<IQuickAction>()
                .Select(a => new
                {
                    pluginId = PlugInRegistry.GetPlugInOwningHook(a).Id,
                    hookType = a.GetType().FullName,
                    label = a.Label,
                    description = a.Description,
                    disabled = a.DisabledInfo.Disabled,
                    reason = a.DisabledInfo.Reason,
                })
                .ToList(),
        });
    }

    private Task<object> LoadSave(JsonElement payload)
    {
        var fileName = payload.GetProperty("fileName").GetString() ?? "save.sav";
        var base64 = payload.GetProperty("base64").GetString() ?? string.Empty;
        var bytes = Convert.FromBase64String(base64);

        GameService.Load(bytes, fileName);
        _draftPokemon = null;
        _encounterResults.Clear();
        return GetState();
    }

    private Task<object> UpdateTrainer(JsonElement payload)
    {
        var game = GameService.LoadedGame;
        if (payload.TryGetProperty("money", out var money) && money.ValueKind == JsonValueKind.Number)
        {
            game.Trainer.Money.Set(money.GetUInt32());
        }

        if (payload.TryGetProperty("battlePoints", out var battlePoints) && battlePoints.ValueKind == JsonValueKind.Number && game.BattlePoints.IsSupported(out var supported))
        {
            supported.BattlePoints = battlePoints.GetInt32();
        }

        if (payload.TryGetProperty("gender", out var gender) && gender.ValueKind == JsonValueKind.String)
        {
            game.Trainer.Gender = gender.GetString() switch
            {
                nameof(Gender.Female) or "Female" => Gender.Female,
                nameof(Gender.Genderless) or "Genderless" => Gender.Genderless,
                _ => Gender.Male,
            };
        }

        return GetState();
    }

    private Task<object> ExportSave()
    {
        using var stream = GameService.Export();
        using var memory = new MemoryStream();
        stream.CopyTo(memory);

        return Task.FromResult<object>(new
        {
            fileName = GameService.FileName ?? "save.sav",
            base64 = Convert.ToBase64String(memory.ToArray()),
        });
    }

    private Task<object> GetCollection(JsonElement payload)
    {
        var source = payload.GetProperty("source").GetString() ?? throw new InvalidOperationException("Missing source.");
        var game = GameService.LoadedGame;
        var pokemon = source switch
        {
            "party" => game.Trainer.Party.Pokemons,
            "box" => game.Trainer.PokemonBox.All.Where(p => p.Species.Species != PKHeX.Core.Species.None).ToList(),
            _ => throw new NotSupportedException($"Collection '{source}' is not supported.")
        };

        return Task.FromResult<object>(new
        {
            source,
            entries = pokemon.Select(SerializePokemonSummary).ToList(),
            showdown = pokemon.Showdown(),
        });
    }

    private Task<object> GetPokemon(JsonElement payload)
    {
        var source = payload.GetProperty("source").GetString() ?? throw new InvalidOperationException("Missing source.");
        var uniqueId = UniqueId.From(payload.GetProperty("uniqueId").GetString() ?? throw new InvalidOperationException("Missing pokemon id."));

        var pokemon = FindPokemon(source, uniqueId);
        return Task.FromResult<object>(SerializePokemonDetails(source, pokemon));
    }

    private Task<object> SavePokemon(JsonElement payload)
    {
        var source = payload.GetProperty("source").GetString() ?? throw new InvalidOperationException("Missing source.");
        var uniqueId = UniqueId.From(payload.GetProperty("uniqueId").GetString() ?? throw new InvalidOperationException("Missing pokemon id."));
        var pokemon = FindPokemon(source, uniqueId);
        var pokemonPayload = payload.GetProperty("pokemon");

        if (pokemonPayload.TryGetProperty("nickname", out var nickname) && nickname.ValueKind == JsonValueKind.String)
        {
            pokemon.ChangeNickname(nickname.GetString()?.Trim() ?? string.Empty);
        }

        if (pokemonPayload.TryGetProperty("level", out var level) && level.ValueKind == JsonValueKind.Number)
        {
            pokemon.ChangeLevel(level.GetInt32());
        }

        if (pokemonPayload.TryGetProperty("shiny", out var shiny) && shiny.ValueKind is JsonValueKind.True or JsonValueKind.False)
        {
            pokemon.SetShiny(shiny.GetBoolean());
        }

        if (pokemonPayload.TryGetProperty("gender", out var gender) && gender.ValueKind == JsonValueKind.String)
        {
            pokemon.Gender = gender.GetString() switch
            {
                nameof(Gender.Female) or "Female" => Gender.Female,
                nameof(Gender.Genderless) or "Genderless" => Gender.Genderless,
                _ => Gender.Male,
            };
        }

        if (pokemonPayload.TryGetProperty("trainer", out var trainer) && trainer.ValueKind == JsonValueKind.Object)
        {
            if (trainer.TryGetProperty("currentHandler", out var currentHandler) && currentHandler.ValueKind == JsonValueKind.String)
            {
                pokemon.Owner.CurrentHandler = currentHandler.GetString() switch
                {
                    nameof(Owner.Handler.SomeoneElse) or "SomeoneElse" => Owner.Handler.SomeoneElse,
                    _ => Owner.Handler.OriginalTrainer,
                };
            }

            if (trainer.TryGetProperty("tid", out var tid) && tid.ValueKind == JsonValueKind.Number)
                pokemon.Owner.TID = tid.GetUInt32();
            if (trainer.TryGetProperty("sid", out var sid) && sid.ValueKind == JsonValueKind.Number)
                pokemon.Owner.SID = sid.GetUInt32();
            if (trainer.TryGetProperty("name", out var ownerName) && ownerName.ValueKind == JsonValueKind.String)
                pokemon.Owner.Name = ownerName.GetString() ?? string.Empty;
            if (trainer.TryGetProperty("gender", out var ownerGender) && ownerGender.ValueKind == JsonValueKind.String)
                pokemon.Owner.Gender = ownerGender.GetString() switch
                {
                    nameof(Gender.Female) or "Female" => Gender.Female,
                    nameof(Gender.Genderless) or "Genderless" => Gender.Genderless,
                    _ => Gender.Male,
                };
            if (trainer.TryGetProperty("handlingTrainerName", out var handlingTrainerName) && handlingTrainerName.ValueKind == JsonValueKind.String)
                pokemon.Owner.HandlingTrainerName = handlingTrainerName.GetString() ?? string.Empty;
            if (trainer.TryGetProperty("handlingTrainerGender", out var handlingTrainerGender) && handlingTrainerGender.ValueKind == JsonValueKind.String)
                pokemon.Owner.HandlingTrainerGender = handlingTrainerGender.GetString() switch
                {
                    nameof(Gender.Female) or "Female" => Gender.Female,
                    nameof(Gender.Genderless) or "Genderless" => Gender.Genderless,
                    _ => Gender.Male,
                };
        }

        if (pokemonPayload.TryGetProperty("friendship", out var friendship) && friendship.ValueKind == JsonValueKind.Number)
        {
            pokemon.Friendship = friendship.GetInt32();
        }

        if (pokemonPayload.TryGetProperty("nature", out var nature) && nature.ValueKind == JsonValueKind.String)
        {
            var rawNature = nature.GetString();
            if (!Enum.TryParse<Nature>(rawNature, true, out var parsedNature) || !pokemon.Natures.ChangeAll(parsedNature))
            {
                throw new InvalidOperationException($"Could not set nature '{rawNature}'.");
            }
        }

        if (pokemonPayload.TryGetProperty("heldItemId", out var heldItemId) && heldItemId.ValueKind == JsonValueKind.Number)
        {
            pokemon.HeldItem = pokemon.Game.ItemRepository.GetGameItem(heldItemId.GetUInt16());
        }

        if (pokemonPayload.TryGetProperty("abilityId", out var abilityId) && abilityId.ValueKind == JsonValueKind.Number)
        {
            pokemon.Ability = AbilityRepository.Instance.Get(abilityId.GetInt32());
        }

        if (pokemonPayload.TryGetProperty("formId", out var formId) && formId.ValueKind == JsonValueKind.Number && pokemon.Form.HasForm)
        {
            var nextForm = FormRepository.GetFor(pokemon).FirstOrDefault(f => f.Id == formId.GetUInt16());
            if (nextForm is not null)
            {
                pokemon.Form.Form = nextForm;
            }
        }

        if (pokemonPayload.TryGetProperty("moveIds", out var moveIds) && moveIds.ValueKind == JsonValueKind.Array)
        {
            var nextMoves = moveIds.EnumerateArray().Select(e => e.GetUInt16()).ToArray();
            if (nextMoves.Length == 4)
            {
                pokemon.ChangeMove(PokemonMove.MoveIndex.Move1, MoveRepository.Instance.GetMove(nextMoves[0]));
                pokemon.ChangeMove(PokemonMove.MoveIndex.Move2, MoveRepository.Instance.GetMove(nextMoves[1]));
                pokemon.ChangeMove(PokemonMove.MoveIndex.Move3, MoveRepository.Instance.GetMove(nextMoves[2]));
                pokemon.ChangeMove(PokemonMove.MoveIndex.Move4, MoveRepository.Instance.GetMove(nextMoves[3]));
            }
        }

        if (pokemonPayload.TryGetProperty("evs", out var evs) && evs.ValueKind == JsonValueKind.Object)
        {
            ApplyStats(pokemon.EVs, evs);
        }

        if (pokemonPayload.TryGetProperty("ivs", out var ivs) && ivs.ValueKind == JsonValueKind.Object)
        {
            ApplyStats(pokemon.IVs, ivs);
        }

        if (pokemonPayload.TryGetProperty("metBallId", out var metBallId) && metBallId.ValueKind == JsonValueKind.Number)
        {
            pokemon.Ball = ItemRepository.GetItem(metBallId.GetUInt16());
        }

        if (pokemonPayload.TryGetProperty("metLocationId", out var metLocationId) && metLocationId.ValueKind == JsonValueKind.Number)
        {
            pokemon.MetConditions.Location = new Location((ushort)metLocationId.GetInt32(), pokemon.Game.LocationRepository.GetBy((ushort)metLocationId.GetInt32()).Name);
        }

        if (pokemonPayload.TryGetProperty("metLevel", out var metLevel) && metLevel.ValueKind == JsonValueKind.Number)
        {
            pokemon.MetConditions.Level = metLevel.GetInt32();
        }

        if (pokemonPayload.TryGetProperty("metDate", out var metDate) && metDate.ValueKind == JsonValueKind.String)
        {
            var rawDate = metDate.GetString();
            pokemon.MetConditions.Date = string.IsNullOrWhiteSpace(rawDate) ? null : DateOnly.Parse(rawDate!);
        }

        if (pokemonPayload.TryGetProperty("fatefulEncounter", out var fatefulEncounter) && fatefulEncounter.ValueKind is JsonValueKind.True or JsonValueKind.False)
        {
            pokemon.MetConditions.FatefulEncounter = fatefulEncounter.GetBoolean();
        }

        pokemon.Pkm.ResetPartyStats();

        if (pokemon.Pkm is ICombatPower combatPower)
        {
            combatPower.ResetCP();
        }

        return Task.FromResult<object>(SerializePokemonDetails(source, pokemon));
    }

    private Task<object> ExportPokemon(JsonElement payload)
    {
        var uniqueId = UniqueId.From(payload.GetProperty("uniqueId").GetString() ?? throw new InvalidOperationException("Missing pokemon id."));
        var pokemon = _draftPokemon?.UniqueId.Equals(uniqueId) == true
            ? _draftPokemon
            : GameService.LoadedGame.FindPokemon(uniqueId) ?? throw new KeyNotFoundException("Pokemon not found.");
        var file = pokemon.ToFile();

        return Task.FromResult<object>(new
        {
            fileName = file.Name,
            base64 = Convert.ToBase64String(file.Bytes),
        });
    }

    private Task<object> LoadDraftPokemon(JsonElement payload)
    {
        var base64 = payload.GetProperty("base64").GetString() ?? string.Empty;
        _draftPokemon = Pokemon.LoadFrom(Convert.FromBase64String(base64), GameService.Game);
        return Task.FromResult<object>(SerializePokemonDetails("draft", _draftPokemon));
    }

    private Task<object> CreateCloneDraft(JsonElement payload)
    {
        var uniqueId = UniqueId.From(payload.GetProperty("uniqueId").GetString() ?? throw new InvalidOperationException("Missing pokemon id."));
        var pokemon = GameService.LoadedGame.FindPokemon(uniqueId) ?? throw new KeyNotFoundException("Pokemon not found.");
        _draftPokemon = pokemon.MakeCopy();
        return Task.FromResult<object>(SerializePokemonDetails("draft", _draftPokemon));
    }

    private Task<object> GetDraftPokemon()
    {
        if (_draftPokemon is null)
            throw new InvalidOperationException("No draft Pokemon is loaded.");

        return Task.FromResult<object>(SerializePokemonDetails("draft", _draftPokemon));
    }

    private Task<object> AddDraftPokemonToCollection(JsonElement payload)
    {
        if (_draftPokemon is null)
            throw new InvalidOperationException("No draft Pokemon is loaded.");

        var target = payload.GetProperty("target").GetString() ?? "box";
        var added = target switch
        {
            "party" => GameService.LoadedGame.Trainer.Party.AddOnEmptySlot(_draftPokemon),
            _ => GameService.LoadedGame.Trainer.PokemonBox.AddOnEmptySlot(_draftPokemon),
        };

        if (!added)
            throw new InvalidOperationException(target == "party" ? "Your party is full." : "Your pokemon box is full.");

        var addedPokemon = _draftPokemon;
        _draftPokemon = null;
        return Task.FromResult<object>(new
        {
            added = true,
            source = target,
            uniqueId = addedPokemon.UniqueId.ToString(),
            displayName = addedPokemon.NameDisplay(),
        });
    }

    private Task<object> ClearDraftPokemon()
    {
        _draftPokemon = null;
        return Task.FromResult<object>(new { cleared = true });
    }

    private Task<object> GetEncounterSearch()
    {
        var game = GameService.LoadedGame;
        var versions = GameVersionRepository.Instance
            .GetAvailableFor(game.Generation, game.SaveVersion.Version)
            .OrderBy(version => version.Name)
            .ToList();
        var defaultVersion = versions.FirstOrDefault(v => v.Equals(game.GameVersionApproximation)) ?? versions.FirstOrDefault();

        return Task.FromResult<object>(new
        {
            selectedVersionId = defaultVersion?.Id,
            versions = versions.Select(v => new { id = v.Id, name = v.Name }).ToList(),
            species = game.SpeciesRepository.AllGameSpecies.OrderBy(species => species.Name).Select(species => new { id = species.Id, name = species.Name }).ToList(),
            results = Array.Empty<object>(),
        });
    }

    private Task<object> SearchEncounters(JsonElement payload)
    {
        var versionId = payload.GetProperty("versionId").GetInt32();
        var speciesId = payload.GetProperty("speciesId").GetInt32();
        var game = GameService.LoadedGame;
        var versions = GameVersionRepository.Instance
            .GetAvailableFor(game.Generation, game.SaveVersion.Version)
            .OrderBy(version => version.Name)
            .ToList();

        _encounterResults = game.PokemonRepository
            .FindEncounter((GameVersion)versionId, (Species)speciesId)
            .ToList();

        return Task.FromResult<object>(new
        {
            selectedVersionId = versionId,
            versions = versions.Select(v => new { id = v.Id, name = v.Name }).ToList(),
            species = game.SpeciesRepository.AllGameSpecies.OrderBy(species => species.Name).Select(species => new { id = species.Id, name = species.Name }).ToList(),
            results = _encounterResults.Select((encounter, index) => new
            {
                id = index,
                species = encounter.Species.Name(),
                version = encounter.Version.Name,
                location = encounter.Location.Name,
                ball = encounter.Ball.Name,
                levelRange = encounter.LevelRange.Format,
                form = encounter.Form?.Name ?? string.Empty,
            }).ToList(),
        });
    }

    private Task<object> CreateEncounterDraft(JsonElement payload)
    {
        var encounterId = payload.GetProperty("encounterId").GetInt32();
        if (encounterId < 0 || encounterId >= _encounterResults.Count)
            throw new InvalidOperationException("Encounter not found.");

        _draftPokemon = _encounterResults[encounterId].ConvertToPokemon();
        return Task.FromResult<object>(SerializePokemonDetails("draft", _draftPokemon));
    }

    private Task<object> GetItems()
    {
        var inventories = GameService.LoadedGame.Trainer.Inventories;
        return Task.FromResult<object>(new
        {
            inventoryTypes = inventories.InventoryTypes.OrderBy(t => t).ToArray(),
            inventories = inventories.InventoryTypes.OrderBy(t => t).Select(type => new
            {
                type,
                maxItemCountAllowed = inventories[type].MaxItemCountAllowed,
                supportedItems = inventories[type].CurrentSupportedItems.Select(item => new
                {
                    id = item.Id,
                    name = item.Name,
                }).OrderBy(item => item.name).ToList(),
                items = inventories[type].Where(i => !i.IsNone).Select(item => new
                {
                    id = item.Id,
                    name = item.Name,
                    count = item.Count,
                }).ToList()
            }).ToList()
        });
    }

    private Task<object> SetItemCount(JsonElement payload)
    {
        var inventoryType = payload.GetProperty("inventoryType").GetString() ?? throw new InvalidOperationException("Missing inventory type.");
        var itemId = payload.GetProperty("itemId").GetUInt16();
        var count = payload.GetProperty("count").GetUInt32();
        var inventory = GameService.LoadedGame.Trainer.Inventories[inventoryType];

        if (count == 0)
            inventory.Remove(itemId);
        else
            inventory.Set(itemId, count);

        return GetItems();
    }

    private Task<object> GetPluginFailures()
    {
        return Task.FromResult<object>(new
        {
            failures = PlugInRuntime.RecentFailures.Select(f => new
            {
                pluginId = f.PlugIn.Id,
                message = f.Exception.Message,
                stackTrace = f.Exception.StackTrace,
            }).ToList()
        });
    }

    private Task<object> DismissPluginFailure(JsonElement payload)
    {
        var pluginId = payload.GetProperty("pluginId").GetString() ?? string.Empty;
        var message = payload.GetProperty("message").GetString() ?? string.Empty;
        var failure = PlugInRuntime.RecentFailures.FirstOrDefault(f => f.PlugIn.Id == pluginId && f.Exception.Message == message);
        if (failure is not null)
        {
            PlugInRuntime.Dismiss(failure);
        }

        return GetPluginFailures();
    }

    private async Task<object> GetPlugins()
    {
        var sources = await PlugInSourceService.GetPlugInSources();
        var installed = PlugInRegistry.GetAllPlugins()
            .Select(SerializePluginSummary)
            .ToList();

        var available = sources
            .SelectMany(source => source.PlugIns.Select(plugin => new { source, plugin }))
            .Where(entry => !PlugInRegistry.IsRegistered(entry.plugin.Id))
            .Select(entry => new
            {
                sourceUrl = entry.source.SourceUrl,
                sourceName = entry.source.Name,
                id = entry.plugin.Id,
                name = entry.plugin.Name,
                description = entry.plugin.Description,
                projectUrl = entry.plugin.ProjectUrl,
                version = entry.plugin.PublishedVersions.LastOrDefault(),
                downloadUrl = entry.source.GetLatestDownloadUrl(entry.plugin),
            })
            .ToList();

        var sourceSummaries = sources
            .Select(source => new
            {
                sourceUrl = source.SourceUrl,
                sourceManifestUrl = source.SourceManifestUrl,
                name = source.Name,
                description = source.SourceDescription,
                pluginCount = source.PlugIns.Length,
                installedCount = source.PlugIns.Count(plugin => PlugInRegistry.IsRegistered(plugin.Id)),
                isDefault = source.SourceUrl == PlugInSource.DefaultSourcePath || source.SourceManifestUrl == PlugInSource.DefaultSourceUrl,
            })
            .OrderBy(source => source.name)
            .ToList();

        return new { installed, available, sources = sourceSummaries };
    }

    private async Task<object> AddPluginSource(JsonElement payload)
    {
        var sourceUrl = payload.GetProperty("sourceUrl").GetString()
                        ?? throw new InvalidOperationException("Missing source url.");

        var normalized = sourceUrl.Trim();
        if (string.IsNullOrWhiteSpace(normalized))
            throw new InvalidOperationException("Source URL cannot be empty.");

        var fetchUrl = normalized.EndsWith(PlugInSource.ManifestFileName, StringComparison.OrdinalIgnoreCase)
            ? normalized
            : $"{normalized.TrimEnd('/')}/{PlugInSource.ManifestFileName}";

        var fetched = await PlugInSourceService.FetchFrom(fetchUrl)
                     ?? throw new InvalidOperationException("Could not fetch a valid plugin source manifest.");

        PlugInSourceLocalStorage.PersistSource(fetched);
        return await GetPlugins();
    }

    private async Task<object> RemovePluginSource(JsonElement payload)
    {
        var sourceUrl = payload.GetProperty("sourceUrl").GetString()
                        ?? throw new InvalidOperationException("Missing source url.");
        var sources = await PlugInSourceService.GetPlugInSources();
        var source = sources.FirstOrDefault(s => s.SourceUrl == sourceUrl || s.SourceManifestUrl == sourceUrl)
                     ?? throw new InvalidOperationException("Plugin source not found.");

        PlugInSourceService.Remove(source);
        return await GetPlugins();
    }

    private Task<object> GetPlugin(JsonElement payload)
    {
        var pluginId = payload.GetProperty("pluginId").GetString()
                       ?? throw new InvalidOperationException("Missing plugin id.");
        var plugin = PlugInRegistry.GetBy(pluginId);

        var hooks = PlugInRegistry.GetAllHooksOf(plugin)
            .Select(hook => new
            {
                type = hook.GetType().FullName,
                name = hook.GetType().Name,
                description = hook.Description,
                kind = HookKind(hook),
                enabled = plugin.IsHookEnabled(hook),
            })
            .ToList();

        var settings = plugin.Settings.All
            .Select(pair => SerializeSetting(pair.Key, pair.Value))
            .ToList();

        return Task.FromResult<object>(new
        {
            plugin = SerializePluginSummary(plugin),
            hooks,
            settings,
        });
    }

    private async Task<object> InstallPlugin(JsonElement payload)
    {
        var sourceUrl = payload.GetProperty("sourceUrl").GetString()
                        ?? throw new InvalidOperationException("Missing source url.");
        var downloadUrl = payload.GetProperty("downloadUrl").GetString()
                          ?? throw new InvalidOperationException("Missing download url.");

        await PlugInService.InstallFrom(sourceUrl, downloadUrl);
        return await GetPlugins();
    }

    private async Task<object> UninstallPlugin(JsonElement payload)
    {
        var plugin = PlugInRegistry.GetBy(payload.GetProperty("pluginId").GetString()!);
        await PlugInService.Uninstall(plugin);
        return await GetPlugins();
    }

    private async Task<object> UpdatePlugin(JsonElement payload)
    {
        var plugin = PlugInRegistry.GetBy(payload.GetProperty("pluginId").GetString()!);
        await PlugInService.Update(plugin);
        return await GetPlugin(payload);
    }

    private async Task<object> SetPluginEnabled(JsonElement payload)
    {
        var plugin = PlugInRegistry.GetBy(payload.GetProperty("pluginId").GetString()!);
        plugin.Enabled = payload.GetProperty("enabled").GetBoolean();
        await PlugInLocalStorage.Persist(plugin);
        return await GetPlugin(payload);
    }

    private async Task<object> SetHookEnabled(JsonElement payload)
    {
        var plugin = PlugInRegistry.GetBy(payload.GetProperty("pluginId").GetString()!);
        var hookType = payload.GetProperty("hookType").GetString()
                       ?? throw new InvalidOperationException("Missing hook type.");

        plugin.SetToggle(hookType, payload.GetProperty("enabled").GetBoolean());
        await PlugInLocalStorage.Persist(plugin);
        return await GetPlugin(payload);
    }

    private async Task<object> SetPluginSetting(JsonElement payload)
    {
        var plugin = PlugInRegistry.GetBy(payload.GetProperty("pluginId").GetString()!);
        var key = payload.GetProperty("key").GetString() ?? throw new InvalidOperationException("Missing setting key.");
        var kind = payload.GetProperty("kind").GetString() ?? throw new InvalidOperationException("Missing setting kind.");

        plugin.Settings[key] = kind switch
        {
            "string" => new Settings.SettingValue.StringValue(payload.GetProperty("value").GetString() ?? string.Empty),
            "boolean" => new Settings.SettingValue.BooleanValue(payload.GetProperty("value").GetBoolean()),
            "integer" => new Settings.SettingValue.IntegerValue(payload.GetProperty("value").GetInt32()),
            "file" => new Settings.SettingValue.FileValue(
                Convert.FromBase64String(payload.GetProperty("base64").GetString() ?? string.Empty),
                payload.GetProperty("fileName").GetString() ?? string.Empty),
            _ => throw new NotSupportedException($"Unsupported setting kind '{kind}'.")
        };

        await PlugInLocalStorage.Persist(plugin);
        return await GetPlugin(payload);
    }

    private async Task<object> RunQuickAction(JsonElement payload)
    {
        var plugin = PlugInRegistry.GetBy(payload.GetProperty("pluginId").GetString()!);
        var hookType = payload.GetProperty("hookType").GetString()
                       ?? throw new InvalidOperationException("Missing hook type.");
        var action = PlugInRegistry.GetAllHooksOf(plugin)
            .OfType<IQuickAction>()
            .FirstOrDefault(a => a.GetType().FullName == hookType)
            ?? throw new InvalidOperationException($"Could not find quick action '{hookType}'.");

        var outcome = await action.OnActionRequested();
        return HandleOutcome(plugin, outcome);
    }

    private Task<object> ShowPluginPage(JsonElement payload)
    {
        var pluginId = payload.GetProperty("pluginId").GetString()!;
        var path = payload.GetProperty("path").GetString()!;

        _plugIn = PlugInRegistry.GetBy(pluginId);
        _page = PlugInPageRegistry.GetPageFor(pluginId, path)
            ?? throw new KeyNotFoundException($"Plugin page '{path}' was not found for plugin '{pluginId}'.");
        return RefreshPluginShell(new { shown = true, layout = _page.Layout.ToString().ToLowerInvariant() });
    }

    private Task<object> ClearPluginPage()
    {
        _plugIn = null;
        _page = null;
        return RefreshPluginShell(new { cleared = true });
    }

    private async Task<object> RefreshPluginShell(object payload)
    {
        await InvokeAsync(StateHasChanged);
        return payload;
    }

    private object HandleOutcome(LoadedPlugIn plugin, Outcome outcome) => outcome switch
    {
        Outcome.Notification notification => new
        {
            type = "notification",
            notification = new
            {
                message = notification.Message,
                description = notification.Description,
                severity = notification.Type.ToString().ToLowerInvariant(),
            }
        },
        Outcome.PlugInPage page => RegisterPage(plugin, page),
        _ => new { type = "none" }
    };

    private object RegisterPage(LoadedPlugIn plugin, Outcome.PlugInPage page)
    {
        PlugInPageRegistry.Register(plugin.Id, page);
        return new
        {
            type = "pluginPage",
            pluginPage = new
            {
                pluginId = plugin.Id,
                path = page.Path,
                layout = page.Layout.ToString().ToLowerInvariant(),
                title = page.PageHeader?.Title ?? plugin.Settings.Manifest.PlugInName,
            }
        };
    }

    private Dictionary<string, object?> AssembleComponentParams()
    {
        if (_page is null || _plugIn is null) return [];

        return new()
        {
            { nameof(PkHexWebPlugInComponent.PlugInSettings), _plugIn.Settings },
            { nameof(PkHexWebPlugInComponent.Game), GameService.Game },
            { nameof(PkHexWebPlugInComponent.FileName), GameService.FileName },
        };
    }

    private static object SerializePluginSummary(LoadedPlugIn plugin) => new
    {
        id = plugin.Id,
        name = plugin.Settings.Manifest.PlugInName,
        description = plugin.Settings.Manifest.Description,
        version = plugin.Version.ToString(),
        enabled = plugin.Enabled,
        hasNewerVersion = plugin.HasNewerVersion,
        projectUrl = plugin.Settings.Manifest.ProjectUrl,
        publicKeyToken = plugin.PublicKeyToken,
        sourceId = plugin.SourceId,
        information = plugin.Settings.Manifest.Information,
    };

    private static object SerializeSetting(string key, Settings.SettingValue value) => value switch
    {
        Settings.SettingValue.StringValue stringValue => new { key, kind = "string", value = stringValue.Value, readOnly = stringValue.ReadOnly },
        Settings.SettingValue.BooleanValue booleanValue => new { key, kind = "boolean", value = booleanValue.Value, readOnly = booleanValue.ReadOnly },
        Settings.SettingValue.IntegerValue integerValue => new { key, kind = "integer", value = integerValue.Value, readOnly = integerValue.ReadOnly },
        Settings.SettingValue.FileValue fileValue => new
        {
            key,
            kind = "file",
            fileName = fileValue.FileName,
            hasFile = fileValue.Value.Length > 0,
            readOnly = fileValue.ReadOnly,
        },
        _ => new { key, kind = "unknown" }
    };

