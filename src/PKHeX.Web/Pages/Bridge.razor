    private static void ApplyStats(Stats stats, JsonElement payload)
    {
        if (payload.TryGetProperty("hp", out var hp) && hp.ValueKind == JsonValueKind.Number) stats.Health = hp.GetInt32();
        if (payload.TryGetProperty("atk", out var atk) && atk.ValueKind == JsonValueKind.Number) stats.Attack = atk.GetInt32();
        if (payload.TryGetProperty("def", out var def) && def.ValueKind == JsonValueKind.Number) stats.Defense = def.GetInt32();
        if (payload.TryGetProperty("spa", out var spa) && spa.ValueKind == JsonValueKind.Number) stats.SpecialAttack = spa.GetInt32();
        if (payload.TryGetProperty("spd", out var spd) && spd.ValueKind == JsonValueKind.Number) stats.SpecialDefense = spd.GetInt32();
        if (payload.TryGetProperty("spe", out var spe) && spe.ValueKind == JsonValueKind.Number) stats.Speed = spe.GetInt32();
    }

    private static string SerializeLegalitySummary(Pokemon pokemon)
    {
        var analysis = pokemon.Legality();
        if (analysis.Valid)
        {
            return "No invalid checks found.";
        }

        var invalidChecks = analysis.Results
            .Where(result => result.Judgement == Severity.Invalid)
            .Select(result => result.Identifier.ToString())
            .Distinct()
            .Take(3)
            .ToList();

        return invalidChecks.Count == 0
            ? "Legality checks failed."
            : string.Join(", ", invalidChecks);
    }

    private static List<object> SerializeLegalityIssues(Pokemon pokemon)
    {
        var analysis = pokemon.Legality();
        var localization = LegalityLocalizationContext.Create(analysis);
        var issues = new List<object>();

        foreach (var result in analysis.Results.Where(result => result.Judgement == Severity.Invalid))
        {
            issues.Add(new
            {
                code = result.Identifier.ToString(),
                message = localization.Humanize(result)
            });
        }

        return issues;
    }

    private static string HookKind(IPluginHook hook) => hook switch
    {
        IQuickAction => "quick-action",
        IPokemonEditAction => "pokemon-edit-action",
        IPokemonStatsEditAction => "pokemon-stats-action",
        IRunOnPokemonChange => "pokemon-change",
        IRunOnPokemonSave => "pokemon-save",
        IRunOnItemChanged => "item-change",
        _ => "hook"
    };

